rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{userId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;
    }
    match /diccionario/{palabraId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'wichi', 'castellano', 'variante', 'creadoEn', 'verificado'
        ])
        && request.resource.data.keys().hasAll([
          'wichi', 'castellano', 'variante', 'creadoEn', 'verificado'
        ])
        && request.resource.data.wichi is string
        && request.resource.data.wichi.size() > 0
        && request.resource.data.wichi.size() <= 100
        && request.resource.data.castellano is string
        && request.resource.data.castellano.size() > 0
        && request.resource.data.castellano.size() <= 200
        && request.resource.data.variante == 'Dragones'
        && request.resource.data.creadoEn == request.time
        && request.resource.data.verificado == false;
      allow update, delete: if false;
    }
  }
}
